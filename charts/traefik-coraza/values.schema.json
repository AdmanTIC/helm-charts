{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Ne valide que le bloc `bouncer` : types, énumérations, et surtout les valeurs SANS DÉFAUT requises dès qu'un bouncer est activé (crowdsec.namespace, crowdsec.lapiHost). Les contrats que ce schéma ne sait pas exprimer — plugin déclaré côté subchart Traefik, volumes montés, URLs du captcha — sont vérifiés au rendu par templates/bouncer/guard.yaml, avec des messages détaillés.",
  "type": "object",
  "properties": {
    "bouncer": {
      "type": "object",
      "properties": {
        "crowdsec": {
          "type": "object",
          "properties": {
            "namespace": { "type": "string" },
            "lapiHost": { "type": "string" },
            "lapiScheme": { "enum": ["http", "https"] },
            "dbSecretName": { "type": "string", "minLength": 1 },
            "dbHost": { "type": "string", "minLength": 1 },
            "dbName": { "type": "string", "minLength": 1 }
          }
        },
        "registerJob": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "hashSuffix": { "type": "boolean" },
        "crowdsecMode": { "enum": ["stream", "live", "alone", "appsec"] },
        "updateMaxFailure": { "type": ["string", "integer"] },
        "updateIntervalSeconds": { "type": ["string", "integer"] },
        "logLevel": { "enum": ["DEBUG", "INFO", "ERROR"] },
        "ban": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "bouncerName": { "type": "string", "minLength": 1 },
            "middlewareName": { "type": "string", "minLength": 1 },
            "pluginAlias": { "type": "string", "minLength": 1 },
            "statusCode": { "type": ["string", "integer"] }
          }
        },
        "captcha": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "bouncerName": { "type": "string", "minLength": 1 },
            "middlewareName": { "type": "string", "minLength": 1 },
            "pluginAlias": { "type": "string", "minLength": 1 },
            "provider": { "enum": ["custom", "hcaptcha", "recaptcha", "turnstile"] },
            "gracePeriodSeconds": { "type": ["string", "integer"] }
          }
        },
        "sonde": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "type": "string", "minLength": 1 },
            "schedule": { "type": "string", "minLength": 1 },
            "nodeName": { "type": "string" },
            "edges": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "testIP": { "type": "string", "minLength": 1 },
            "banDuration": { "type": "string", "minLength": 1 },
            "propagationTimeoutSeconds": { "type": "integer", "minimum": 10 },
            "activeDeadlineSeconds": { "type": "integer", "minimum": 60 },
            "lapiDeployment": { "type": "string", "minLength": 1 },
            "dryRun": { "type": "boolean" },
            "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
            "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 }
          },
          "allOf": [
            {
              "$comment": "Sonde activée : ses deux ancres n'ont pas de défaut plausible (le nœud d'où elle émet, les edges qu'elle vérifie). La porte (forwardedHeaders) est vérifiée par bouncer/guard.yaml, qui peut l'expliquer.",
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": {
                "properties": {
                  "nodeName": { "type": "string", "minLength": 1 },
                  "edges": { "type": "array", "minItems": 1 }
                },
                "required": ["nodeName", "edges"]
              }
            }
          ]
        },
        "attach": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "middleware": { "enum": ["ban", "captcha"] },
            "bypassHosts": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "allOf": [
        {
          "$comment": "Un bouncer activé exige l'adhérence CrowdSec EXPLICITE : pas de défaut plausible pour le namespace de la stack ni pour l'hôte de la LAPI.",
          "if": {
            "anyOf": [
              { "properties": { "ban": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] } }, "required": ["ban"] },
              { "properties": { "captcha": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] } }, "required": ["captcha"] }
            ]
          },
          "then": {
            "properties": {
              "crowdsec": {
                "properties": {
                  "namespace": { "type": "string", "minLength": 1 },
                  "lapiHost": { "type": "string", "minLength": 1 }
                },
                "required": ["namespace", "lapiHost"]
              }
            },
            "required": ["crowdsec"]
          }
        }
      ]
    }
  }
}
